# SecureSOC AI - Environment Configuration
# Copy this file to .env: cp .env.example .env

# LLM Provider Configuration (Optional for mock mode; required for live mode)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Execution Mode: "mock" (offline deterministic) or "live" (calls Gemini API)
EXECUTION_MODE=mock

# System Parameters
DEBUG=True
